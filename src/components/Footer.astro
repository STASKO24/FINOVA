---
import ActionLink from './ActionLink.astro';
import { services } from '../data/home';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const affiliateNames = ['ANPORA GROUP', 'CLARITY CONSULTING', 'FINOVA SINGAPORE', 'FINOVA HONG KONG'];
const footerServices = services.filter((_, i) => i !== 5);
---
<footer class="site-footer">
  <div class="site-footer__photo"><img src={`${base}/images/story-04.webp`} width="640" height="640" alt="Timber-panelled hallway" loading="lazy" decoding="async" /><p data-i18n="footerTagline">A trusted partner dedicated to your growth.</p><ActionLink href="#contact" label="Contact us" translation="contactUs" tone="paper" variant="text" /></div>
  <nav class="footer-nav footer-nav--company" aria-label="Company"><h2 data-i18n="company">Company</h2><a href="#about" data-i18n="about">About</a><a href="https://www.finovagroup.com/finova-impact" target="_blank" rel="noopener noreferrer" data-i18n="impact">Impact</a><a href="#contact" data-i18n="contactUs">Contact us</a></nav>
  <nav class="footer-nav footer-nav--resources" aria-label="Resources"><h2 data-i18n="resources">Resources</h2>{['Careers','Insights','Events'].map(label => <a href={`https://www.finovagroup.com/${label.toLowerCase()}`} target="_blank" rel="noopener noreferrer" data-i18n={label.toLowerCase()}>{label}</a>)}</nav>
  <nav class="footer-nav footer-nav--services" aria-label="Services"><h2 data-i18n="ourServicesFooter">Our Services</h2>{footerServices.map(service => <a href={`#service-trigger-${services.indexOf(service)}`} data-open-service={services.indexOf(service)}>{service.title.replace(' Services', services.indexOf(service) === 0 ? '' : ' Services')}</a>)}</nav>
  <div class="site-footer__offices">{affiliateNames.map(name => <div class="footer-office"><h2>{name}</h2><address>8 Rue de Bragance<br />L-1255 Luxembourg</address><a href="tel:+352225902">T: +352 22 59 02</a><a href="https://www.anporagroup.com" target="_blank" rel="noopener noreferrer">W: www.anporagroup.com</a></div>)}</div>
  <div class="site-footer__wordmark" aria-hidden="true"><img src={`${base}/images/finova-wordmark.svg`} width="1400" height="307" alt="" /><span style={`--mark:url('${base}/favicon-dark.png')`}></span></div>
  <p class="site-footer__copyright" data-i18n="copyright">© 2026 Finova Group. All Rights Reserved.</p><div class="site-footer__legal"><a href="https://www.finovagroup.com/terms-of-use" target="_blank" rel="noopener noreferrer" data-i18n="terms">Terms &amp; Conditions</a><a href="https://www.finovagroup.com/privacy-policy" target="_blank" rel="noopener noreferrer" data-i18n="privacy">Privacy Policy</a></div>
</footer>

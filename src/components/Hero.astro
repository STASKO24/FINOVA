---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slides = [
  { name: 'The lounge', alt: 'Amber-lit lounge with warm wood panels and curved velvet seating', file: 'slide-01.webp', width: 1179, height: 1569, position: '50% 74.177%' },
  { name: 'The library', alt: 'A warmly lit library with an armchair and framed artwork', file: 'slide-02.webp', width: 736, height: 1103, position: '50% 50%' },
  { name: 'The conversation', alt: 'Two professionals in conversation in a softly lit lounge', file: 'slide-03.webp', width: 736, height: 923, position: '50% 50%' },
  { name: 'The meeting room', alt: 'An elegant meeting room framed by dark timber panels', file: 'slide-04.webp', width: 928, height: 1160, position: '50% 50%' },
];
---
<main id="main">
  <section class="hero" aria-label="FINOVA Group" aria-roledescription="carousel" tabindex="0" data-carousel data-active="0">
    <svg class="filter-definitions" aria-hidden="true" width="0" height="0">
      <defs>
        {slides.map((_, i) => (
          <filter id={`hero-blur-${i}`} x="-20%" y="-30%" width="140%" height="160%" color-interpolation-filters="sRGB">
            <feGaussianBlur stdDeviation="0 0" data-blur={i} />
          </filter>
        ))}
      </defs>
    </svg>
    <div class="hero__slides" id="hero-slides">
      {slides.map((slide, i) => (
        <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i !== 0}>
          <img src={`${base}/images/${slide.file}`} alt={slide.alt} width={slide.width} height={slide.height}
            fetchpriority={i === 0 ? 'high' : 'auto'} loading="eager" decoding="async" draggable="false" style={`object-position:${slide.position}`} />
        </div>
      ))}
    </div>

    <header class="header">
      <div class="header__left">
        <button class="text-control" data-menu-open aria-haspopup="dialog" aria-controls="site-menu" data-i18n="menu">Menu</button>
        <div class="language" aria-label="Language">
          <button class="text-control" data-lang="en" aria-pressed="true" aria-label="English">EN</button>
          <span aria-hidden="true"> / </span>
          <button class="text-control" data-lang="zh" aria-pressed="false" aria-label="中文">CN</button>
        </div>
      </div>
      <a class="brand" href={`${base}/`} aria-label="FINOVA Group home" style={`--logo:url('${base}/images/finova-logo.png')`}>
        <img src={`${base}/images/finova-logo.png`} alt="FINOVA Group" width="2134" height="1398" />
      </a>
      <a class="text-control header__contact" href="https://www.finovagroup.com/connect-with-us" target="_blank" rel="noopener noreferrer" data-i18n="contacts">Contacts</a>
    </header>

    <div class="hero__content">
      <h1><span data-i18n="title1">World-Class</span><span data-i18n="title2">Corporate Services</span></h1>
      <p class="hero__location"><span data-i18n="location1">Singapore &amp;</span><span data-i18n="location2">Hong Kong</span></p>
    </div>

    <div class="slide-picker" role="group" aria-label="Choose an image">
      {slides.map((slide, i) => (
        <button class:list={['slide-picker__item', { 'is-active': i === 0 }]} data-slide-button={i} aria-label={`Show image ${i + 1}: ${slide.name}`} aria-pressed={i === 0} aria-controls="hero-slides">
          <img src={`${base}/images/${slide.file}`} alt="" width={slide.width} height={slide.height} style={`object-position:${slide.position}`} />
          <span class="slide-picker__progress" aria-hidden="true"></span>
        </button>
      ))}
      <button class="playback" data-playback aria-label="Pause slideshow" aria-pressed="false"><span class="playback__icon" aria-hidden="true"></span></button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-slide-status></p>
  </section>
</main>

<dialog class="site-menu" id="site-menu" aria-label="Navigation">
  <div class="site-menu__header"><span>FINOVA Group</span><button class="text-control" data-menu-close autofocus data-i18n="close">Close</button></div>
  <nav aria-label="Main navigation">
    <a href={`${base}/`} data-menu-home data-i18n="home">Home</a>
    <a href="https://www.finovagroup.com/about-finova" target="_blank" rel="noopener noreferrer" data-i18n="about">Who we are</a>
    <a href="https://www.finovagroup.com/connect-with-us" target="_blank" rel="noopener noreferrer" data-i18n="contacts">Contacts</a>
  </nav>
  <p>Singapore &amp; Hong Kong</p>
</dialog>

<script>
  import '../scripts/hero';
</script>

---
import RollingText from './RollingText.astro';
import '../styles/scroll-navbar.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="scroll-navbar" aria-label="Scroll navigation" aria-hidden="true" inert data-scroll-navbar data-state="hidden">
  <div class="scroll-navbar__left">
    <button class="text-control menu-trigger" data-menu-open aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false"><RollingText text="Menu" translation="menu" /></button>
    <div class="language" aria-label="Language">
      <button class="text-control" data-lang="en" aria-pressed="true" aria-label="English">EN</button>
      <span aria-hidden="true"> / </span>
      <button class="text-control" data-lang="zh" aria-pressed="false" aria-label="中文">CN</button>
    </div>
  </div>
  <a class="scroll-navbar__home" href={`${base}/`} aria-label="FINOVA Group home">
    <span class="site-menu__mark" style={`--logo:url('${base}/images/finova-logo.png')`} aria-hidden="true"></span>
  </a>
  <a class="text-control" href="https://www.finovagroup.com/connect-with-us" target="_blank" rel="noopener noreferrer" data-i18n="contacts">Contacts</a>
</header>

<script>
  import '../scripts/scroll-navbar';
</script>

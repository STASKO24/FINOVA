---
import '../styles/finova-values.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const values = [
  { label: 'Finova' },
  { label: 'Professionalism', translation: 'valuesProfessionalism' },
  { label: 'Passion', translation: 'valuesPassion' },
  { label: 'Agility', translation: 'valuesAgility' },
];
---
<section class="finova-values" id="finova-values" aria-labelledby="finova-values-heading" data-finova-values>
  <div class="finova-values__media" aria-hidden="true">
    <div class="finova-values__image" data-values-image>
      <img src={`${base}/images/finova-values.webp`} alt="" width="736" height="913" loading="lazy" decoding="async" />
    </div>
  </div>

  <ul class="finova-values__principles">
    {values.map(value => <li data-i18n={value.translation}>{value.label}</li>)}
  </ul>

  <div class="finova-values__copy">
    <h2 class="finova-values__statement" id="finova-values-heading" tabindex="-1" data-i18n="valuesCopy">Most businesses end up with four or five providers who never compare notes. Finova was built so one team sees the whole company.</h2>
    <a class="finova-values__link" href="https://www.finovagroup.com/about-finova" target="_blank" rel="noopener noreferrer">
      <span class="finova-values__link-label" data-i18n="learnMore">Learn more</span>
      <span class="finova-values__link-icon" aria-hidden="true"><span style={`--arrow:url('${base}/images/arrow-forward.svg')`}></span></span>
    </a>
  </div>
</section>

<script>
  import '../scripts/finova-values';
</script>

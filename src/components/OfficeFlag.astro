---
interface Props { country: string; }
const { country } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<img class="office-flag" src={`${base}/images/flag-${country}.png`} width="420" height="280" alt={country === 'sg' ? 'Singapore flag' : 'Hong Kong flag'} loading="lazy" decoding="async" />

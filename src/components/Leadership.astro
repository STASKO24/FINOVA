---
import { directors, offices } from '../data/home';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="leadership-section home-section" id="leadership" aria-labelledby="leadership-heading" data-leadership>
  <h2 id="leadership-heading" data-i18n="teamHeading">The directors who lead each practice, in both offices.</h2>
  <p class="leadership-section__description" data-i18n="teamDescription">With more than 15 years of proven track record, serving more than 1,500 clients</p>
  <div class="leadership-section__tabs" role="tablist" aria-label="Office team">{offices.map((office, i) => <button id={`team-tab-${office.id}`} role="tab" aria-selected={i === 0} aria-controls={`team-panel-${office.id}`} tabindex={i === 0 ? 0 : -1} data-team-tab={office.id}><img src={`${base}/images/flag-${office.flag}.png`} width="420" height="280" alt="" /><span data-i18n={`officeCity${i}`}>{office.city}</span></button>)}</div>
  {offices.map((office, officeIndex) => <div class="leadership-section__track" id={`team-panel-${office.id}`} role="tabpanel" aria-labelledby={`team-tab-${office.id}`} hidden={officeIndex !== 0} tabindex="0" aria-label={`${office.city} directors, scroll horizontally to see all`} data-team-track>
    {directors.filter(d => d.office === office.id).map((director, i) => <article class:list={['director-card', { 'is-active': i === 0 }]} data-director-card tabindex="0">
      <div class="director-card__image" data-director-image><img src={`${base}/images/director-${director.image}.webp`} alt={director.name} width="900" height="1016" loading="lazy" decoding="async" /></div>
      <div class="director-card__shade" aria-hidden="true"></div>
      <div class="director-card__details"><div><h3>{director.name}</h3><p data-i18n={`directorRole${directors.indexOf(director)}`}>{director.role}</p></div><a class="director-card__profile" href="https://www.finovagroup.com/about-finova" target="_blank" rel="noopener noreferrer" aria-label={`Read about ${director.name}`}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 3a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6ZM3 9h3v12H3V9Zm6 0h2.9v1.6h.1a4.1 4.1 0 0 1 3.7-1.9c4 0 4.8 2.6 4.8 6V21h-3v-5.6c0-1.9 0-4.1-2.5-4.1s-2.9 2-2.9 4V21H9V9Z"/></svg></a></div>
    </article>)}
  </div>)}
  <div class="team-cursor" data-team-cursor aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
</section>
